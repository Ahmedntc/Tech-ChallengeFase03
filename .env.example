# Ambiente da aplicação: development | production
APP_ENV=development

# Nível de log da API
LOG_LEVEL=info

# Porta em que a API FastAPI é servida
API_PORT=8000

# Caminho do modelo carregado pela API (sklearn .pkl ou .onnx)
MODEL_PATH=models/model.pkl
MODEL_FORMAT=sklearn

# Prometheus / Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
